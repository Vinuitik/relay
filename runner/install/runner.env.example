# Copy this to /etc/relay/runner.env and edit, then:
#   sudo systemctl restart relay-runner@<user>

# Where the runner keeps its key, project registry, and scaffolded project dirs.
# Defaults to ~/.relay for whichever user the service runs as if unset.
#RELAY_HOME=/home/youruser/.relay

# Bind address. MUST be the Tailscale interface's address, never 0.0.0.0 or a
# LAN-facing address — see ARCHITECTURE.md "Registration / connection".
# Find your Tailscale IP with: tailscale ip -4
# Leave unset for local-only testing (defaults to 127.0.0.1:7777, unreachable
# from your phone) — set this before you actually rely on phone access.
#RELAY_LISTEN_ADDR=100.x.y.z:7777

# "claude" and "codex" are auto-detected on PATH - no config needed if the
# CLI is installed where this runner's user can see it. Only set these to
# override the bare command (custom install path, extra flags, e.g.
# RELAY_PROVIDER_CLAUDE="/opt/claude/bin/claude --some-flag").
#RELAY_PROVIDER_CLAUDE=claude
#RELAY_PROVIDER_CODEX=codex

# Wake-on-LAN and idle-suspend are independent of each other. Idle-suspend
# defaults OFF - see runner/FLOWS.md "Idle-suspend (S5)" before enabling it,
# it will power off this machine. Do not enable this on a machine you're
# actively testing from.
#RELAY_IDLE_SUSPEND_ENABLED=true
#RELAY_IDLE_TIMEOUT=30m
#RELAY_IDLE_CHECK_INTERVAL=1m

# Path to a Google service-account JSON key, for real FCM push. Unset =
# runner logs and skips notifications instead of sending them - safe default,
# see runner/FLOWS.md "Device registration + notify-on-finish".
#RELAY_FCM_CREDENTIALS=/etc/relay/fcm-service-account.json

# Self-update: checks GitHub Releases for a newer runner build at startup and
# every RELAY_UPDATE_CHECK_INTERVAL after, downloads + verifies + installs it,
# then exits (systemd's Restart=always brings the new version up). Defaults
# ON - set to false to pin the currently-installed version. See
# runner/FLOWS.md "Self-update".
#RELAY_AUTO_UPDATE_ENABLED=false
#RELAY_UPDATE_CHECK_INTERVAL=10m
