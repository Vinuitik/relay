# Copy this to /etc/waker/waker.env and edit, then:
#   sudo systemctl restart wakerd@<user>

# Bind address. MUST be this Pi's Tailscale interface address, never 0.0.0.0
# or a bare LAN address - same reasoning as the runner's RELAY_LISTEN_ADDR.
# Find it with: tailscale ip -4
# Leave unset for local-only testing (defaults to 127.0.0.1:7778, unreachable
# from your phone) - set this before you actually rely on phone access.
#WAKER_LISTEN_ADDR=100.x.y.z:7778

# Where wakerd keeps its key and hand-edited machine list (config.json).
# Defaults to ~/.waker for whichever user the service runs as if unset.
#WAKER_HOME=/home/youruser/.waker
