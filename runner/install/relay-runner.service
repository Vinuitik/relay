[Unit]
Description=Relay runner (via keeperd)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=%i
# keeperd runs relay-runner as its child and swaps in new releases - see
# runner/FLOWS.md "keeperd". It exits (code 3) after replacing its own binary;
# Restart=always brings up the new one.
ExecStart=/opt/relay/bin/keeperd
Restart=always
RestartSec=5
TimeoutStopSec=20
EnvironmentFile=-/etc/relay/runner.env

# Restart=always (not on-failure): the runner may exit 0 on purpose (e.g. after an
# in-place binary swap), which on-failure would treat as "done, don't restart".

# Idle-suspend (RELAY_IDLE_SUSPEND_ENABLED=true, set in /etc/relay/runner.env)
# calls `systemctl poweroff` as this unit's own user. Give that user passwordless
# sudo for poweroff/shutdown specifically (see install.sh) rather than running
# this whole service as root.
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
