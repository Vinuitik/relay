<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required at runtime on API 33+ to actually show the job-done notification posted by
         RelayFirebaseMessagingService - requested in MainActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- For in-app QR scanning when adding a runner (CameraX + ML Kit barcode scanning) -
         requested at runtime before the scanner screen opens, see ui/screens/QrScanScreen.kt. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- No CHANGE_WIFI_MULTICAST_STATE needed here: the phone never broadcasts the WoL packet
         itself, it POSTs /v1/wake to another runner's HTTP API, which broadcasts locally on its
         own LAN — see ARCHITECTURE.md "Relay device" and widget/WakeRunnerWorker.kt. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Relay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Relay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".fcm.RelayFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.RelayWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.relay.app.widget.ACTION_WAKE" />
                <action android:name="com.relay.app.widget.ACTION_STOP_CONTAINERS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/relay_widget_info" />
        </receiver>

    </application>

</manifest>
